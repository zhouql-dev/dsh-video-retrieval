# ── 通用 ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
.DS_Store
*.log
*.bak*

# ── 构建产物（由 build.mjs / release.yml 生成，不入库）────────────────────────
dist/
node_modules/
packages/vr-plugin/dist/

# ── 权重与大素材（setup.sh 下载到 models/；VTL_WEIGHTS_DIR 可覆盖）─────────────
models/
yolov8s-worldv2.pt

# ── 运行态：唯一可写根在 ~/.dsh/video-retrieval（VTL_STATE_DIR 可覆盖），
#    包内不允许出现这些目录（scripts/sync.sh --check 会拦）──────────────────
packages/vr-backend/vr_backend/jobs/
packages/vr-backend/vr_backend/uploads/
packages/vr-backend/vr_backend/work/
packages/vr-backend/vr_backend/outputs/
packages/vr-backend/vr_backend/config/

# ── 密钥 ────────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
