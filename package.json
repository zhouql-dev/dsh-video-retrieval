{
  "name": "dsh-video-retrieval",
  "private": false,
  "version": "0.3.0",
  "type": "module",
  "description": "DeepSeek Harness native mode plugin for surveillance video retrieval: natural-language query or reference image → temporal intervals + per-frame bounding-box trajectories + annotated artifacts, with a cloud-edge funnel, multi-signal voting, and a recursive self-improvement loop.",
  "main": "packages/vr-plugin/dist/index.js",
  "exports": {
    ".": "./packages/vr-plugin/dist/index.js",
    "./client": "./packages/vr-plugin/dist-client/index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./packages/vr-plugin/cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node packages/vr-plugin/build.mjs",
    "test": "python3 tests/run_all.py",
    "prepare": "node packages/vr-plugin/build.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zhouql-dev/dsh-video-retrieval"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.2-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  }
}
